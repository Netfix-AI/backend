# ==========================================
# NETFIX AI — MARG GROUP (Backend Environment Configuration)
# ==========================================

# ==========================================
# SERVER
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# APPLICATION URLS
# ==========================================
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=your-256-bit-jwt-secret-key-change-in-production
JWT_EXPIRY=7d

# ==========================================
# OTP
# ==========================================
OTP_EXPIRY_MINUTES=10

# ==========================================
# SUPABASE
# ==========================================
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# BREVO EMAIL
# ==========================================
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=notifications@netfixai.com
BREVO_SENDER_NAME=Netfix AI — MARG GROUP

# ==========================================
# CLOUDFLARE TURNSTILE
# ==========================================
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# ==========================================
# OLLAMA
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434

# ── AI Agent Layer (Phase 1) ──────────────────────────────────────────────────
# Obtain your Gemini API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Flash-tier model name (fast, lower-cost inference)
GEMINI_MODEL_FLASH=gemini-1.5-flash

# Pro-tier model name (complex, high-accuracy inference)
GEMINI_MODEL_PRO=gemini-1.5-pro

# AES-256-GCM encryption key — self-generated 32-byte (64-character) lowercase hex string
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
